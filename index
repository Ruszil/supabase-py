  <script>
    // Filter functionality
    const filterButtons = document.querySelectorAll(".filter-btn");
    const items = document.querySelectorAll(".item");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        filterButtons.forEach((btn) => {
          btn.classList.remove("active", "bg-blue-500", "text-white");
          btn.style.backgroundColor = "";
          btn.style.color = "";
        });
        button.classList.add("active");
        button.style.backgroundColor = "#3b82f6";
        button.style.color = "white";

        const filter = button.getAttribute("data-filter");

        items.forEach((item) => {
          if (filter === "all") {
            item.style.display = "block";
          } else {
            if (
              item.getAttribute("data-category").toLowerCase() ===
              filter.toLowerCase()
            ) {
              item.style.display = "block";
            } else {
              item.style.display = "none";
            }
          }
        });
      });
    });

    // Initialize the "All" button style on page load
    window.addEventListener("DOMContentLoaded", () => {
      const allBtn = document.querySelector('.filter-btn[data-filter="all"]');
      if (allBtn) {
        allBtn.style.backgroundColor = "#3b82f6";
        allBtn.style.color = "white";
      }
    });

    // Dark mode toggle with icon change and full page dark mode
    const darkModeToggle = document.getElementById("darkModeIcon");
    const body = document.getElementById("pageBody");
    const filterBtns = document.querySelectorAll(".filter-btn");
    const postBtn = document.getElementById("post-item-button");
    const itemsList = document.querySelectorAll(".item");
    const headerIcons = document.getElementById("headerIcons");
    const backBtn = document.getElementById("backBtn");
    const greetingSection = document.getElementById("greetingSection");

    darkModeToggle.addEventListener("click", () => {
      const isDark =
        body.classList.toggle("bg-black") && body.classList.toggle("text-white");

      // Update filter buttons colors for dark mode
      filterBtns.forEach((btn) => {
        if (body.classList.contains("bg-black")) {
          btn.classList.remove("bg-gray-300", "text-black");
          btn.classList.add("bg-gray-700", "text-white");
        } else {
          btn.classList.remove("bg-gray-700", "text-white");
          btn.classList.add("bg-gray-300", "text-black");
        }
      });

      // Update post button colors for dark mode
      if (body.classList.contains("bg-black")) {
        postBtn.classList.remove("bg-gray-300", "text-gray-800");
        postBtn.classList.add("bg-gray-700", "text-white");
      } else {
        postBtn.classList.remove("bg-gray-700", "text-white");
        postBtn.classList.add("bg-gray-300", "text-gray-800");
      }

      // Update item backgrounds for dark mode
      itemsList.forEach((item) => {
        if (body.classList.contains("bg-black")) {
          item.classList.remove("bg-gray-300", "text-black");
          item.classList.add("bg-gray-700", "text-white");
        } else {
          item.classList.remove("bg-gray-700", "text-white");
          item.classList.add("bg-gray-300", "text-black");
        }
      });

      // Update header icons color for dark mode
      if (body.classList.contains("bg-black")) {
        headerIcons.classList.remove("text-black");
        headerIcons.classList.add("text-white");
        backBtn.querySelector("img").classList.add("filter-white");
      } else {
        headerIcons.classList.remove("text-white");
        headerIcons.classList.add("text-black");
        backBtn.querySelector("img").classList.remove("filter-white");
      }

      // Make greeting section text white in dark mode, black in light mode
      if (body.classList.contains("bg-black")) {
        greetingSection.classList.add("text-white");
        greetingSection.classList.remove("text-black");
      } else {
        greetingSection.classList.remove("text-white");
        greetingSection.classList.add("text-black");
      }

      // Change icon from moon to sun and vice versa
      if (body.classList.contains("bg-black")) {
        darkModeToggle.classList.remove("fa-moon");
        darkModeToggle.classList.add("fa-sun");
      } else {
        darkModeToggle.classList.remove("fa-sun");
        darkModeToggle.classList.add("fa-moon");
      }
    });

    // Post item button navigation
    const postItemBtn = document.getElementById("post-item-button");
    postItemBtn.addEventListener("click", () => {
      window.location.href = "newpage.html";
    });

    // Notification button navigation
    const notificationBtn = document.getElementById("notificationBtn");
    notificationBtn.addEventListener("click", () => {
      window.location.href = "NotificationPage.html";
    });

    // Expand item and show Claim button on click
    items.forEach((item) => {
      item.addEventListener("click", () => {
        // Collapse all other items
        items.forEach((other) => {
          if (other !== item) {
            other.style.maxHeight = null;
            other.classList.remove("expanded");
            const btn = other.querySelector(".claim-btn");
            if (btn) {
              btn.style.opacity = "0";
              btn.style.pointerEvents = "none";
            }
          }
        });

        // Toggle current item
        const isExpanded = item.classList.contains("expanded");
        if (isExpanded) {
          item.style.maxHeight = null;
          item.classList.remove("expanded");
          const btn = item.querySelector(".claim-btn");
          if (btn) {
            btn.style.opacity = "0";
            btn.style.pointerEvents = "none";
          }
        } else {
          item.style.maxHeight = "200px";
          item.classList.add("expanded");
          const btn = item.querySelector(".claim-btn");
          if (btn) {
            btn.style.opacity = "1";
            btn.style.pointerEvents = "auto";
          }
        }
      });
    });

    // Claim button navigation
    const claimButtons = document.querySelectorAll(".claim-btn");
    claimButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent triggering the item click event
        window.location.href = "Claimpage.html";
      });
    });
  </script>
